{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voice Practice Native Bridge Protocol",
  "description": "Typed message bridge contract between bundled WebView and native shell (iOS/Android/Desktop).",
  "type": "object",
  "required": ["id", "operation"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operation": {
      "enum": ["models", "chat", "credential.has", "credential.set", "credential.clear"]
    },
    "providerId": { "type": "string", "maxLength": 64 },
    "baseUrl": { "type": "string", "maxLength": 2048 },
    "model": { "type": "string", "maxLength": 256 },
    "messages": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "enum": ["system", "user", "assistant"] },
          "content": { "type": "string", "maxLength": 32000 }
        },
        "additionalProperties": false
      }
    },
    "maxTokens": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "credential": { "type": "string", "maxLength": 4096 }
  },
  "additionalProperties": false
}
