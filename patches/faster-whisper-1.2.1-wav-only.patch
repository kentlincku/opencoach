 import numpy as np


+def _decode_pcm_wav(
+    input_file: Union[str, BinaryIO],
+    sampling_rate: int = 16000,
+    split_stereo: bool = False,
+):
+    if isinstance(input_file, (str, bytes, bytearray)):
+        f = io.BytesIO(input_file) if isinstance(input_file, (bytes, bytearray)) else input_file
+        wav = wave.open(f, "rb")
+    else:
+        wav = wave.open(input_file, "rb")
+
+    with wav:
+        n_channels = wav.getnchannels()
+        sampwidth = wav.getsampwidth()
+        framerate = wav.getframerate()
+        n_frames = wav.getnframes()
+        frames = wav.readframes(n_frames)
+
+    if sampwidth != 2:
+        raise ValueError(f"Unsupported sample width {sampwidth} (only 16-bit PCM is supported)")
+    if framerate != sampling_rate:
+        raise ValueError(f"Sample rate {framerate} does not match required {sampling_rate}")
+
+    audio = np.frombuffer(frames, dtype=np.int16).astype(np.float32) / 32768.0
+
+    if n_channels == 2:
+        left_channel = audio[0::2]
+        right_channel = audio[1::2]
+        if split_stereo:
+            return left_channel, right_channel
+        return (left_channel + right_channel) / 2.0
+    elif n_channels == 1:
+        if split_stereo:
+            return audio, audio
+        return audio
+    else:
+        raise ValueError(f"Unsupported channel count {n_channels}")
+
+
